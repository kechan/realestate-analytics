# Development proxy; used by the Vite server, not exposed as a browser secret.
API_PROXY_TARGET=http://127.0.0.1:8013
# Browser-facing API prefix. Keep relative for same-origin deployments.
VITE_API_BASE_URL=/api/v1
# Optional OSM-compatible basemap; retain the provider's attribution.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
